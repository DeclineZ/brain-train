AUTH_MODE=dual
ENABLE_DEV_LOGIN=false

# Edge-only launch secrets: VITALMIND_LAUNCH_VERIFY_URL,
# VITALMIND_IDENTITY_PEPPER and ALLOWED_ORIGINS.
# MODULE_API_KEY is also required here while Next.js hosts VitalMind internal API routes.
MODULE_API_KEY=
VITALMIND_RATE_LIMIT_PER_MINUTE=60

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; required by Braintrian OA entry/claim and other admin routes.
SUPABASE_SECRET_KEY=

# LINE OA login (Next.js server only). Keep disabled until SQL/Edge deployment.
BRAINTRIAN_OA_TESTING=false
# Same encryption key in Next.js and braintrian-bot Edge secrets:
# Encryption key: 32 random bytes encoded as 64 lowercase hexadecimal characters.
BRAINTRIAN_CLAIM_ENCRYPTION_KEY=
# Next.js calls Edge with the existing SUPABASE_SECRET_KEY (server only).
# Edge-only: OA_BOT_BASE_URL, OA_BOT_API_KEY, BRAINTRIAN_IDENTITY_PEPPER.
